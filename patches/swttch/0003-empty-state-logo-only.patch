+import { describe, it, expect } from 'vitest';
+import { render } from '@testing-library/react';
+import { APP_NAME } from '@/config/app';
+import { EmptyState } from '../EmptyState';
+
+// Local patch (Claude Picker): the empty chat is the logo and nothing under it, so a
+// session switch never flashes Clawd, tips, the setup checklist or announcement cards.
+describe('EmptyState (Claude Picker)', () => {
+  it('renders only the logo', () => {
+    const { container, getByAltText } = render(<EmptyState />);
+
+    expect(getByAltText(APP_NAME)).toBeTruthy();
+    expect(container.querySelectorAll('img')).toHaveLength(1);
+    expect(container.textContent).toBe('');
+  });
+});
