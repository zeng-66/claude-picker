diff --git a/webview/src/pages/ChatPage/ChatInput/__tests__/InputFrame.hostTheme.test.tsx b/webview/src/pages/ChatPage/ChatInput/__tests__/InputFrame.hostTheme.test.tsx
new file mode 100644
index 0000000..1a68307
--- /dev/null
+++ b/webview/src/pages/ChatPage/ChatInput/__tests__/InputFrame.hostTheme.test.tsx
@@ -0,0 +1,21 @@
+import { describe, it, expect } from 'vitest';
+import { render } from '@testing-library/react';
+import { InputFrame, FRAME_BORDER, FRAME_BORDER_FOCUSED } from '../InputFrame';
+
+// Local patch (Claude Picker): the frame uses the host accent colour in every mode.
+describe('InputFrame (Claude Picker)', () => {
+  it('uses the host accent border instead of the mode colour', () => {
+    for (const mode of ['auto', 'plan', 'bypass', 'ask_before_edit', 'auto_edit'] as const) {
+      const { container, unmount } = render(<InputFrame mode={mode} editor={<div />} />);
+      const frame = container.firstElementChild as HTMLElement;
+      expect(frame.className).toContain(FRAME_BORDER);
+      expect(frame.className).not.toMatch(/border-(red|blue|orange|gray)-/);
+      unmount();
+    }
+  });
+
+  it('lights the accent border on focus', () => {
+    const { container } = render(<InputFrame mode="auto" isFocused editor={<div />} />);
+    expect((container.firstElementChild as HTMLElement).className).toContain(FRAME_BORDER_FOCUSED);
+  });
+});
