diff --git a/Web/src/shell/work/WecomChatPreview.jsx b/Web/src/shell/work/WecomChatPreview.jsx
new file mode 100644
index 0000000..79c5d90
--- /dev/null
+++ b/Web/src/shell/work/WecomChatPreview.jsx
@@ -0,0 +1,102 @@
+import React, { useEffect, useState } from 'react';
+import { errorText, request } from '../bridge.js';
+
+const cards = {
+  work: { title: '创建任务', actions: [['confirm', '确认创建'], ['clarify', '补充信息'], ['cancel', '取消']] },
+  decision: { title: '待拍板', actions: [['a', '采用方案 A'], ['b', '采用方案 B'], ['wait', '稍后决定']] },
+};
+
+export default function WecomChatPreview({ profileId, providers, projects }) {
+  const localProjects = projects.filter((item) => !item.isHome);
+  const [actor, setActor] = useState('alice');
+  const [scope, setScope] = useState('group');
+  const [projectPath, setProjectPath] = useState(localProjects[0]?.path ?? '');
+  const [records, setRecords] = useState({});
+  const [text, setText] = useState('');
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState('');
+  const key = JSON.stringify([scope, actor, projectPath]);
+  const record = records[key];
+  const engine = providers.find((item) => item.id === record?.provider)?.label;
+  const card = record?.card;
+  const template = cards[card?.type];
+  const context = { profileId, actor, scope, projectPath };
+
+  useEffect(() => {
+    let current = true;
+    request('prototype.wecom.conversations', { profileId }).then((result) => { if (current) setRecords(result); })
+      .catch((cause) => { if (current) setError(errorText(cause)); });
+    return () => { current = false; };
+  }, [profileId]);
+
+  async function apply(method, payload = {}) {
+    if (pending) return false;
+    setPending(true);
+    setError('');
+    try {
+      const result = await request(method, { ...context, ...payload });
+      setRecords((current) => ({ ...current, [key]: result }));
+      return true;
+    } catch (cause) {
+      setError(errorText(cause));
+      return false;
+    } finally {
+      setPending(false);
+    }
+  }
+
+  function change(setter, event) {
+    setter(event.target.value);
+    setText('');
+    setError('');
+  }
+
+  return (
+    <div className="wecom-isolation-preview" data-review="企业微信 · 人员与会话隔离">
+      <h4>隔离续聊演示</h4>
+      <p>切换发言人、私聊／群聊或项目，查看各自的会话和记录。</p>
+      <div className="wecom-preview-fields">
+        <label className="field">发言人<select aria-label="发言人" value={actor} disabled={pending} onChange={(event) => change(setActor, event)}>
+          <option value="alice">小林</option><option value="bob">小周</option>
+        </select></label>
+        <label className="field">会话场景<select aria-label="会话场景" value={scope} disabled={pending} onChange={(event) => change(setScope, event)}>
+          <option value="group">同一个项目群</option><option value="direct">与机器人的私聊</option>
+        </select></label>
+      </div>
+      <label className="field">演示项目<select aria-label="演示项目" value={projectPath} disabled={pending} onChange={(event) => change(setProjectPath, event)}>
+        {localProjects.map((item) => <option key={item.path} value={item.path}>{item.title}</option>)}
+      </select></label>
+      {record ? (
+        <div className="wecom-conversation-preview">
+          <strong>{engine ?? record.provider} · {record.turns.length} 轮</strong>
+          <code title="引擎原始会话 ID">{record.sessionId}</code>
+          <ol aria-label="当前身份的会话记录">{record.turns.map(({ message, reply }, index) => (
+            <li key={index}><span>{message}</span><small>{reply}</small></li>
+          ))}</ol>
+        </div>
+      ) : <p className="muted">当前身份在此场景和项目还没有会话。</p>}
+      <form className="wecom-preview-message" onSubmit={async (event) => {
+        event.preventDefault();
+        if (text.trim() && await apply('prototype.wecom.message', { text: text.trim() })) setText('');
+      }}>
+        <input aria-label="模拟企微消息" placeholder="输入企微消息" value={text} onChange={(event) => setText(event.target.value)} />
+        <button type="submit" disabled={pending || !text.trim() || !projectPath}>模拟发送</button>
+      </form>
+      {record && <div className="wecom-preview-card" data-review="企业微信 · 决策卡片">
+        <div className="settings-inline">
+          <button disabled={pending || card?.status === 'pending'} onClick={() => apply('prototype.wecom.createCard', { type: 'work' })}>演示创建任务卡</button>
+          <button disabled={pending || card?.status === 'pending'} onClick={() => apply('prototype.wecom.createCard', { type: 'decision' })}>演示拍板卡</button>
+        </div>
+        {template && <div className="wecom-card-body">
+          <strong>{template.title}</strong>
+          <p>{card.type === 'work' ? '将本轮对话整理成工作任务，创建后等待执行。' : '选择是否先交付核心功能，其余能力留待下一版。'}</p>
+          {card.status === 'handled' ? <p role="status">已选择「{template.actions.find(([value]) => value === card.choice)?.[1]}」（演示）</p> :
+            <div className="settings-inline">{template.actions.map(([value, label]) => (
+              <button key={value} disabled={pending} onClick={() => apply('prototype.wecom.chooseCard', { cardId: card.id, choice: value })}>{label}</button>
+            ))}</div>}
+        </div>}
+      </div>}
+      {error && <p className="pane-note error" role="alert">{error}</p>}
+    </div>
+  );
+}
