diff --git a/Web/src/shell/UsagePopover.jsx b/Web/src/shell/UsagePopover.jsx
new file mode 100644
index 0000000..f744814
--- /dev/null
+++ b/Web/src/shell/UsagePopover.jsx
@@ -0,0 +1,134 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ArrowsClockwise, CaretRight, ChartBar, Swap, X } from '@phosphor-icons/react';
+import { request } from './bridge.js';
+
+function quotaRows(usage) {
+  return [
+    { id: 'codex', label: 'Codex', plan: 'Plus', limits: [['5 小时', 34, '2 小时 47 分钟'], ['每周', 81, '1 天 1 小时']] },
+    { id: 'claude', label: 'Claude', plan: 'Pro', limits: [['5 小时', usage?.session?.percent ?? 40, usage?.session?.reset ?? '23:50'], ['每周', usage?.weekly?.percent ?? 26, usage?.weekly?.reset ?? '11-18']] },
+    { id: 'antigravity', label: 'Antigravity', plan: '', limits: [['Gemini 周', 3, '6 天 22 小时'], ['Claude / GPT 周', 0, '6 天 22 小时']] },
+  ];
+}
+
+function QuotaMeter({ limit, remaining, summary = false, showReset = false }) {
+  const [label, used, reset] = limit;
+  const percent = remaining ? 100 - used : used;
+  return (
+    <span className={`cli-quota-meter${summary ? ' is-summary' : ''}`} title={`${label} · ${reset} 重置`}>
+      {!summary && <small>{label}</small>}
+      <span className="cli-quota-track" aria-hidden="true"><i style={{ width: `${percent}%` }} /></span>
+      <strong>{percent}%</strong>
+      {showReset && <small>{reset} 重置</small>}
+    </span>
+  );
+}
+
+function EngineIdentity({ row, icon }) {
+  return (
+    <span className="cli-quota-engine">
+      <img src={icon} alt="" />
+      <span>{row.label}{row.plan && <small> · {row.plan}</small>}</span>
+    </span>
+  );
+}
+
+export default function UsagePopover({ usage, engineIcons }) {
+  const [open, setOpen] = useState(false);
+  const [remaining, setRemaining] = useState(false);
+  const [compact, setCompact] = useState(false);
+  const [expanded, setExpanded] = useState(null);
+  const [page, setPage] = useState('summary');
+  const [refreshing, setRefreshing] = useState(false);
+  const [updated, setUpdated] = useState('');
+  const [refreshedUsage, setRefreshedUsage] = useState(null);
+  const root = useRef(null);
+  const trigger = useRef(null);
+  const rows = quotaRows(refreshedUsage ?? usage);
+  const mostUsed = (row) => row.limits.reduce((a, b) => b[1] > a[1] ? b : a);
+
+  useEffect(() => {
+    if (!open) return;
+    const outside = (event) => { if (!root.current?.contains(event.target)) setOpen(false); };
+    const escape = (event) => {
+      if (event.key === 'Escape') { setOpen(false); trigger.current?.focus(); }
+    };
+    document.addEventListener('pointerdown', outside);
+    document.addEventListener('keydown', escape);
+    return () => {
+      document.removeEventListener('pointerdown', outside);
+      document.removeEventListener('keydown', escape);
+    };
+  }, [open]);
+
+  async function refresh() {
+    setRefreshing(true);
+    try {
+      const snapshot = await request('app.state');
+      setRefreshedUsage(snapshot.usage);
+      setUpdated(new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }));
+    } catch {
+      setUpdated('刷新失败');
+    } finally {
+      setRefreshing(false);
+    }
+  }
+
+  return (
+    <div className="cli-usage" ref={root} data-review="项目侧栏 · 额度入口">
+      <button className="cli-usage-trigger" type="button" ref={trigger} aria-expanded={open} aria-label="使用额度"
+        onClick={() => { setOpen(!open); if (!open) setPage('summary'); }}>
+        <ChartBar size={14} /><span>{remaining ? '剩余' : '已用'}</span>
+        {rows.map((row) => <span className="cli-quota-badge" key={row.id} title={row.label}>
+          <img src={engineIcons[row.id]} alt={row.label} />
+          <QuotaMeter limit={compact ? mostUsed(row) : row.limits[0]} remaining={remaining} summary />
+        </span>)}
+      </button>
+      {open && (
+        <section className="cli-usage-panel" role="region" aria-label="使用量" data-review="项目侧栏 · 额度面板">
+          <header>
+            <strong>{page === 'accounts' ? '管理账户' : page === 'history' ? '使用详情与历史' : '使用量'}</strong>
+            {page === 'summary' && <small>所有引擎{updated && ` · ${updated}`}</small>}
+            <button aria-label="刷新额度" disabled={refreshing} onClick={refresh}><ArrowsClockwise size={14} /></button>
+            <div className="cli-usage-header-actions">
+              {page === 'summary' && <button aria-label={remaining ? '显示已用额度' : '显示剩余额度'} onClick={() => setRemaining(!remaining)}>{remaining ? '剩余' : '已用'} <Swap size={12} /></button>}
+              <button aria-label="关闭额度面板" onClick={() => setOpen(false)}><X size={14} /></button>
+            </div>
+          </header>
+          {page === 'summary' ? (
+            <>
+              <div className="cli-usage-mode" role="group" aria-label="额度显示密度">
+                <button aria-pressed={!compact} onClick={() => setCompact(false)}>详细</button>
+                <button aria-pressed={compact} onClick={() => setCompact(true)}>精简</button>
+              </div>
+              <div className="cli-usage-rows">
+                {rows.map((row) => <div key={row.id}>
+                  <button className="cli-usage-row" aria-expanded={expanded === row.id} onClick={() => setExpanded(expanded === row.id ? null : row.id)}>
+                    <EngineIdentity row={row} icon={engineIcons[row.id]} />
+                    <small>{(compact ? mostUsed(row) : row.limits[0])[2]} 重置</small>
+                    {compact && <QuotaMeter limit={mostUsed(row)} remaining={remaining} summary />}
+                    <CaretRight size={12} />
+                  </button>
+                  {(!compact || expanded === row.id) && <div className="cli-usage-limits">{row.limits.map((limit) => <QuotaMeter key={limit[0]} limit={limit} remaining={remaining} showReset={expanded === row.id} />)}</div>}
+                </div>)}
+              </div>
+              <div className="cli-usage-links">
+                <button onClick={() => setPage('history')}>使用详情与历史 <CaretRight size={12} /></button>
+                <button onClick={() => setPage('accounts')}>管理账户 <CaretRight size={12} /></button>
+              </div>
+            </>
+          ) : (
+            <div className="cli-usage-subpage">
+              <button onClick={() => setPage('summary')}>← 返回用量</button>
+              {page === 'history' ? <><p>当前额度快照（演示）</p>{rows.map((row) => <div key={row.id}><EngineIdentity row={row} icon={engineIcons[row.id]} />
+                <div className="cli-usage-limits">{row.limits.map((limit) => <QuotaMeter key={limit[0]} limit={limit} remaining={remaining} showReset />)}</div></div>)}</> :
+                <><p>各引擎的额度跟随其 CLI 登录账户。</p><button onClick={() => {
+                  setOpen(false);
+                  window.dispatchEvent(new Event('cli-review-check'));
+                }}>打开 CLI 配置</button></>}
+            </div>
+          )}
+        </section>
+      )}
+    </div>
+  );
+}
