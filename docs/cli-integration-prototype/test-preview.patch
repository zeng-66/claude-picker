diff --git a/Web/src/shell/CliChatPreview.jsx b/Web/src/shell/CliChatPreview.jsx
new file mode 100644
index 0000000..c579183
--- /dev/null
+++ b/Web/src/shell/CliChatPreview.jsx
@@ -0,0 +1,98 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ArrowDown, ArrowUp, ChatCircleText, Square, Terminal, Wrench } from '@phosphor-icons/react';
+import MarkdownRenderer from '../MarkdownRenderer.jsx';
+import { request } from './bridge.js';
+
+const EMPTY = { turns: [], status: 'idle' };
+
+export default function CliChatPreview({ active, engine, chat, permission, onUseTerminal, onError }) {
+  const [draft, setDraft] = useState('');
+  const [following, setFollowing] = useState(true);
+  const [submitting, setSubmitting] = useState(false);
+  const viewport = useRef(null);
+  const transcript = chat ?? EMPTY;
+  const busy = transcript.status !== 'idle';
+
+  function jumpToLatest() {
+    if (viewport.current) viewport.current.scrollTop = viewport.current.scrollHeight;
+    setFollowing(true);
+  }
+
+  useEffect(() => {
+    if (following && viewport.current) viewport.current.scrollTop = viewport.current.scrollHeight;
+  }, [transcript, following]);
+
+  async function act(method, extra = {}) {
+    try {
+      await request(method, { sessionId: active.sessionId, ...extra });
+      return true;
+    } catch (error) {
+      onError(error.message);
+      return false;
+    }
+  }
+
+  async function send() {
+    if (!draft.trim() || busy || submitting) return;
+    setSubmitting(true);
+    try {
+      jumpToLatest();
+      if (await act('prototype.chat.send', { text: draft.trim(), permission })) setDraft('');
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  return (
+    <div className="cli-chat" data-review="原生聊天 · 会话界面">
+      <header className="cli-chat-header">
+        <ChatCircleText size={17} />
+        <div><strong>{active.label}</strong><small>{engine} · 聊天预览</small></div>
+        <button onClick={onUseTerminal} disabled={busy} title={busy ? "请先结束当前回合" : "切换当前会话的打开方式"}><Terminal size={15} /> 打开终端</button>
+      </header>
+      <div className="cli-chat-transcript" ref={viewport} data-review="原生聊天 · 消息与工具"
+        onScroll={(event) => {
+          const el = event.currentTarget;
+          setFollowing(el.scrollHeight - el.scrollTop - el.clientHeight < 42);
+        }}>
+        <div className="cli-chat-column">
+          {!transcript.turns.length && <p className="cli-chat-empty">在当前工作目录发送一条消息，体验结构化聊天。</p>}
+          {transcript.turns.map((turn) => (
+            <article className="cli-chat-turn" key={turn.id}>
+              <p className="cli-chat-user">{turn.prompt}</p>
+              <details className="cli-chat-tool">
+                <summary><Wrench size={13} /> {turn.tool}</summary>
+                <p>{turn.toolDetail}</p>
+              </details>
+              {turn.permission && <small className="cli-chat-progress">工具审批 · {turn.permission}</small>}
+              {turn.reply && <div className="cli-chat-reply"><MarkdownRenderer content={turn.reply} /></div>}
+            </article>
+          ))}
+          {transcript.status === 'running' && <p className="cli-chat-progress" role="status">正在生成…</p>}
+        </div>
+      </div>
+      {!following && <button className="cli-chat-latest" onClick={jumpToLatest}><ArrowDown size={14} /> 跳到最新</button>}
+      {transcript.status === 'approval' && (
+        <div className="cli-chat-approval" data-review="原生聊天 · 工具审批">
+          <strong>允许读取项目入口？</strong><code>Web/src/main.jsx</code>
+          <button onClick={() => act('prototype.chat.approve', { allow: false })}>拒绝</button>
+          <button onClick={() => act('prototype.chat.approve', { allow: true })}>允许一次</button>
+        </div>
+      )}
+      <form className="cli-chat-composer" data-review="原生聊天 · 输入区" onSubmit={(event) => { event.preventDefault(); send(); }}>
+        <textarea aria-label="聊天输入" placeholder="输入消息 · Shift+Enter 换行" value={draft}
+          onChange={(event) => setDraft(event.target.value)}
+          onKeyDown={(event) => {
+            if (event.key === 'Enter' && !event.shiftKey && !event.nativeEvent.isComposing) {
+              event.preventDefault();
+              send();
+            }
+          }} />
+        <div><small>{active.cwd}</small>
+          {busy ? <button type="button" aria-label="停止生成" onClick={() => act('prototype.chat.stop')}><Square size={16} /></button>
+            : <button type="submit" aria-label="发送消息" disabled={!draft.trim() || submitting}><ArrowUp size={17} /></button>}
+        </div>
+      </form>
+    </div>
+  );
+}
