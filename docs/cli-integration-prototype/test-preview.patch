--- /dev/null
+++ b/Web/src/shell/work/CliSettings.jsx
@@ -0,0 +1,192 @@
+import React, { useState } from 'react';
+import { ArrowsClockwise, ChatCircleText, DotsThree, Terminal, Timer, Warning } from '@phosphor-icons/react';
+import { request } from '../bridge.js';
+
+const engines = {
+  claude: { badge: 'C', modes: ['chat', 'terminal'] },
+  antigravity: { badge: 'A', modes: ['chat', 'terminal'] },
+  codex: { badge: 'Cx', modes: ['chat', 'terminal'] },
+  dsh: { badge: 'Ds', modes: ['terminal'], guide: 'https://github.com/ccch1mneyyy/dsh-TUI#quick-start' },
+};
+const catalog = [
+  { id: 'workbuddy', label: 'WorkBuddy', badge: 'Wb', command: 'CLI 启动入口待验证' },
+  { id: 'opencode', label: 'OpenCode', badge: 'Oc', command: 'opencode', guide: 'https://opencode.ai/docs/' },
+  { id: 'codebuddy', label: 'CodeBuddy', badge: 'Cb', command: 'codebuddy', guide: 'https://www.codebuddy.ai/' },
+];
+const modeLabel = { chat: '聊天', terminal: '终端' };
+
+function ModePreview({ mode }) {
+  return (
+    <div className={`cli-mode-preview ${mode}`} aria-hidden="true">
+      <div><span>{mode === 'chat' ? <ChatCircleText size={14} /> : <Terminal size={14} />}</span> claude-picker</div>
+      {mode === 'chat' ? (
+        <section><b>项目的入口在哪里？</b><p>入口位于 <code>Web/src/main.jsx</code>。</p><small>输入消息…</small></section>
+      ) : (
+        <section><code>$ claude</code><p>› 项目的入口在哪里？</p><small>❯ ▍</small></section>
+      )}
+    </div>
+  );
+}
+
+export default function CliSettings({ providers, settings, onChange, notify }) {
+  const [menu, setMenu] = useState(null);
+  const [guide, setGuide] = useState(false);
+  const globalMode = settings.interactionMode === 'chat' ? 'chat' : 'terminal';
+  const config = settings.cliPreferences ?? {};
+  const preferred = settings.defaultProvider ?? 'claude';
+  const installed = providers.filter((item) => item.available || item.id === 'dsh');
+  const available = [
+    ...providers.filter((item) => !item.available && item.id !== 'dsh'),
+    ...catalog,
+  ];
+
+  function updateEntry(id, patch) {
+    onChange({ cliPreferences: { ...config, [id]: { ...config[id], ...patch } } });
+  }
+
+  function toggleEngine(id) {
+    const enabled = config[id]?.enabled === false;
+    const patch = { cliPreferences: { ...config, [id]: { ...config[id], enabled } } };
+    if (!enabled && preferred === id) {
+      patch.defaultProvider = installed.find((item) => item.id !== id && item.available && config[item.id]?.enabled !== false)?.id ?? null;
+    }
+    onChange(patch);
+  }
+
+  async function refresh() {
+    const snapshot = await request('app.state');
+    notify(`检测到 ${snapshot.providers.filter((item) => item.available).length} 个可启动引擎（演示）`);
+  }
+
+  return (
+    <div className="cli-settings-page" onClick={() => menu && setMenu(null)}>
+      <h3>CLI 引擎</h3>
+      <div className="cli-settings-section" data-review="CLI 配置 · 全局打开方式">
+        <h4>智能体打开方式</h4>
+        <p>新会话默认使用的界面。仅支持终端的引擎会直接打开终端。</p>
+        <div className="cli-mode-grid" role="group" aria-label="智能体打开方式">
+          {Object.entries(modeLabel).map(([mode, label]) => (
+            <button key={mode} className="cli-mode-card" aria-pressed={globalMode === mode}
+              onClick={() => {
+                onChange({ interactionMode: mode });
+              }}>
+              <ModePreview mode={mode} />
+              <strong>{label}</strong>
+              <small>{mode === 'chat' ? '在会话界面阅读消息与工具结果' : '在项目目录中打开引擎的原生终端'}</small>
+            </button>
+          ))}
+        </div>
+        <button className="cli-settings-link" onClick={() => {
+          document.querySelector('#cli-installed-list')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
+        }}>按引擎设置 ↓</button>
+      </div>
+      <div className="cli-settings-section" data-review="CLI 配置 · 新会话默认权限">
+        <h4>新会话</h4>
+        <label className="cli-permission"><span>默认权限</span>
+          <select aria-label="默认权限" value={settings.cliPermission ?? 'inherit'} onChange={(event) => onChange({ cliPermission: event.target.value })}>
+            <option value="inherit">沿用引擎设置</option>
+            <option value="approval">操作前请求批准</option>
+            <option value="readonly">只读</option>
+          </select>
+        </label>
+        <p>权限选项仅供原型评审。实际行为由各 CLI 的权限设置决定。</p>
+      </div>
+      <div className="cli-settings-section" data-review="CLI 配置 · 提示缓存定时器">
+        <h4>提示缓存定时器</h4>
+        <p>Claude 会话空闲后，可以在侧栏查看缓存预计何时过期。</p>
+        <div className="cli-engine-list">
+          <div className="cli-engine-row">
+            <div className="cli-engine-label"><Timer size={17} />
+              <div><strong>缓存定时器</strong><small className="cli-cache-setting-description">显示在 Claude 会话行</small></div>
+            </div>
+            <button className="cli-engine-switch" type="button" role="switch" aria-label="缓存定时器"
+              aria-checked={settings.promptCacheTimer?.enabled !== false}
+              onClick={() => onChange({ promptCacheTimer: { ...settings.promptCacheTimer, enabled: settings.promptCacheTimer?.enabled === false } })} />
+          </div>
+          <div className="cli-engine-row">
+            <div><strong>定时器持续时间</strong><small className="cli-cache-setting-description">按提供商的缓存 TTL 设置，默认 5 分钟。</small></div>
+            <select aria-label="定时器持续时间" disabled={settings.promptCacheTimer?.enabled === false}
+              value={settings.promptCacheTimer?.minutes ?? 5}
+              onChange={(event) => onChange({ promptCacheTimer: { ...settings.promptCacheTimer, minutes: Number(event.target.value) } })}>
+              {[5, 10, 15, 30, 60].map((minutes) => <option key={minutes} value={minutes}>{minutes} 分钟</option>)}
+            </select>
+          </div>
+        </div>
+      </div>
+      <div className="cli-settings-section" id="cli-installed-list" data-review="CLI 配置 · 已安装">
+        <div className="cli-section-title"><h4>已安装 <small>{installed.length} 已检测</small></h4>
+          <button onClick={refresh}><ArrowsClockwise size={14} /> 刷新</button></div>
+        <div className="cli-engine-list">
+          {installed.map((item) => {
+            const engine = engines[item.id];
+            const enabled = config[item.id]?.enabled !== false;
+            const selectedMode = config[item.id]?.mode ?? 'inherit';
+            return (
+              <div className="cli-engine-row" key={item.id}>
+                <div className="cli-engine-label">
+                  <em className={`provider-badge ${item.id}`}>{engine?.badge}</em>
+                  <div><strong>{item.label}{preferred === item.id && <small className="cli-default">默认</small>}</strong>
+                    <code>{item.command}{item.id === 'dsh' ? ' --backend dsh' : ''}</code></div>
+                </div>
+                <div className="cli-engine-actions">
+                  {item.available && engine?.modes.length > 1 && (
+                    <select aria-label={`${item.label} 打开方式`} value={selectedMode} onChange={(event) => updateEntry(item.id, { mode: event.target.value })}>
+                      <option value="inherit">跟随全局</option>
+                      <option value="chat">聊天</option>
+                      <option value="terminal">CLI</option>
+                    </select>
+                  )}
+                  {!item.available && <button className="cli-engine-warning" onClick={() => setGuide(!guide)}><Warning size={14} /> 缺少 dsh</button>}
+                  {item.available && <button type="button" role="switch" className="cli-engine-switch" aria-label={`启用 ${item.label}`} aria-checked={enabled} onClick={() => toggleEngine(item.id)} />}
+                  <div className="cli-engine-menu">
+                    <button aria-label={`${item.label} 更多操作`} aria-expanded={menu === item.id} onClick={(event) => {
+                      event.stopPropagation();
+                      setMenu(menu === item.id ? null : item.id);
+                    }}><DotsThree size={19} /></button>
+                    {menu === item.id && <div className="cli-menu-items" onClick={(event) => event.stopPropagation()}>
+                      {item.available && <label>{item.label} 权限
+                        <select aria-label={`${item.label} 权限`} value={config[item.id]?.permission ?? 'default'} onChange={(event) => updateEntry(item.id, { permission: event.target.value })}>
+                          <option value="default">跟随新会话默认值</option>
+                          <option value="inherit">沿用引擎设置</option>
+                          <option value="approval">操作前请求批准</option>
+                          <option value="readonly">只读</option>
+                        </select>
+                      </label>}
+                      <button disabled={!item.available || !enabled || preferred === item.id} onClick={() => { onChange({ defaultProvider: item.id }); setMenu(null); }}>设为默认引擎</button>
+                      {item.id === 'dsh' && <button onClick={() => { setGuide(true); setMenu(null); }}>依赖与安装</button>}
+                    </div>}
+                  </div>
+                </div>
+              </div>
+            );
+          })}
+        </div>
+        <label className="cli-scan"><input type="checkbox" checked={settings.scanAntigravity !== false}
+          onChange={(event) => onChange({ scanAntigravity: event.target.checked })} /> 聚合 Antigravity 历史会话</label>
+        {guide && (
+          <div className="cli-install-guide" data-review="CLI 配置 · DeepSeek 依赖">
+            <strong>DeepSeek Harness 依赖</strong>
+            <p>dsh-TUI 已检测到。还需要能从 PATH 找到 DeepSeek Harness（dsh）。</p>
+            <a href={engines.dsh.guide} target="_blank" rel="noreferrer">查看安装说明 ↗</a>
+            <button onClick={async () => {
+              await request('prototype.dsh', { available: true });
+              setGuide(false);
+              notify('模拟检测到 dsh');
+            }}>模拟补齐依赖</button>
+          </div>
+        )}
+      </div>
+      <div className="cli-settings-section" data-review="CLI 配置 · 可安装">
+        <div className="cli-section-title"><h4>可安装 <small>{available.length} 个引擎</small></h4></div>
+        <p>安装目录预览。引擎接入与本机检测需单独完成。</p>
+        <div className="cli-engine-list">
+          {available.map((item) => <div className="cli-engine-row" key={item.id}>
+            <div className="cli-engine-label"><em className="provider-badge">{item.badge ?? item.label[0]}</em>
+              <div><strong>{item.label}</strong><code>{item.command}</code></div></div>
+            {item.guide && <a href={item.guide} target="_blank" rel="noreferrer" aria-label={`查看 ${item.label} 安装说明`}>安装说明 ↗</a>}
+          </div>)}
+        </div>
+      </div>
+    </div>
+  );
+}
