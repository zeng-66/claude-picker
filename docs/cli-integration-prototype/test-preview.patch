@@ -0,0 +1,26 @@
+import React, { useEffect, useState } from 'react';
+import { Timer } from '@phosphor-icons/react';
+
+export default function PromptCacheTimer({ startedAt, minutes, running }) {
+  const [now, setNow] = useState(() => Date.now());
+  const expiresAt = startedAt + minutes * 60_000;
+
+  useEffect(() => {
+    if (!startedAt || running || expiresAt <= Date.now()) return;
+    setNow(Date.now());
+    const timer = setInterval(() => {
+      const time = Date.now();
+      setNow(time);
+      if (time >= expiresAt) clearInterval(timer);
+    }, 1000);
+    return () => clearInterval(timer);
+  }, [startedAt, running, expiresAt]);
+
+  if (!startedAt || running) return null;
+  const seconds = Math.max(0, Math.ceil((expiresAt - now) / 1000));
+  if (!seconds) return null;
+  const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
+  return <span className="cli-cache-countdown" title="Claude 提示缓存预计剩余时间" data-review="项目侧栏 · Claude 缓存倒计时">
+    <Timer size={12} /> {text}
+  </span>;
+}
