+  tools.innerHTML = '<span>test · CLI 原型</span><button id="review-check">CLI 配置</button><button id="review-mark">标注区域</button><button id="review-notes">批注</button>';
+  const comments = document.createElement('dialog');
+  comments.className = 'cli-review-dialog';
+  comments.innerHTML = `
+    <h2>界面批注</h2>
+    <label>位置<select id="review-region"></select></label>
+    <label>修改意见<textarea id="review-text" rows="3" required></textarea></label>
+    <p id="review-feedback" role="status"></p>
+    <div class="cli-review-actions"><button data-close>关闭</button><button id="review-export">导出 JSON</button><button id="review-save">保存</button></div>
+    <div id="review-list"></div>`;
+  document.body.append(tools, comments);
+
